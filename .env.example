# Copy this to .env and fill in, or just run `npm run setup` and let the local
# settings UI fill this in for you (recommended).

# --- Gemini (Google AI Studio) ---
# Same account/key as hajriahfajar-autopublish — all 3 pipelines share one
# free-tier key, spread across non-overlapping daily windows so they don't
# collide on quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# --- Google OAuth (Blogger + Sheets) ---
# Same Google account owns every blog (hajriahfajar@gmail.com), so these 3
# values can simply be copied from hajriahfajar-autopublish/.env — no new
# OAuth consent flow is required. Only BLOG_ID and SHEET_ID below are new.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Blogger ---
# The NEW music-story blog. Create it manually at blogger.com first, then
# auto-detect via `npm run setup`, or paste the Blog ID directly (find it in
# the dashboard URL: blogger.com/blog/posts/<BLOG_ID>).
BLOG_ID=

# --- Google Sheets (dedup log) ---
# Auto-created by `npm run setup` if left blank, or paste an existing Sheet ID.
SHEET_ID=

# --- Scheduling ---
# PUBLISH_WINDOW_ID is NOT set here -- it's injected per-run by the GitHub
# Actions workflow from scripts/check-slot.mjs's output ("daily" or "manual").
PUBLISH_TIMEZONE=Asia/Jakarta
